# BetterAuth
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Database (LibSQL)
# Local development: file:./.data/bazardor.db
# Production: libsql://your-db-name.turso.io
DATABASE_URL=file:./.data/bazardor.db
DATABASE_AUTH_TOKEN=

# Social login (optional, both can be empty)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Product data API (optional override)
BAZARDOR_API_URL=https://api.api-store.workers.dev/api/bazardor
